# MUST - environment template.
# Copy to .env.local (gitignored) and fill in real values.
# Only NEXT_PUBLIC_* are read by the app; they are exposed to the browser bundle,
# so never put secrets here.

#  Data API (FastAPI backend/app.py, proxied via Next.js rewrites) 
# Local dev: http://localhost:8000 (the backend/app.py exceedance backend).
# Production: the Cloud Run URL of the deployed API (identity-token auth is added
# automatically by app/lib/api-fetch.ts when this is a non-localhost URL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

#  LIVE-TILE BACKEND (the one-line mock->real swap) 
# Both empty -> placeholder mode: mock heat blobs and the single pre-rendered
#              tile under /public/mock-tiles (currently 2026-03-04).
# Both set   -> live mode: TiTiler renders COG tiles on demand.
# TITILER_BASE is the tile service (CloudFront in front of the titiler Lambda);
# COG_BASE names the datasets and is resolved server-side by TiTiler, so an
# s3:// URL works and the bucket stays private.
NEXT_PUBLIC_TITILER_BASE=
NEXT_PUBLIC_COG_BASE=
NEXT_PUBLIC_TIPG_URL=

#  ON-DEMAND XARRAY TILER (takes precedence over the COG path when set) 
# Base URL of the Backend/geoserve titiler-xarray service: on-demand tiles
# derived from the EA Icechunk store (tp accumulation + ensemble exceedance).
# Local dev: http://localhost:8090 (docker/podman compose, service titiler-xarray).
NEXT_PUBLIC_TILER_XR_BASE=

#  Site 
# Absolute base URL for OpenGraph / metadata. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

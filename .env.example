# MUST environment template. Copy to .env.local (gitignored) and fill in.
# Only NEXT_PUBLIC_* are read by the app and exposed to the browser bundle,
# so never put secrets here.

# Backend base URL for map tiles and data. Local dev: http://localhost:8090.
NEXT_PUBLIC_TILER_XR_BASE=

# Absolute base URL for OpenGraph metadata. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

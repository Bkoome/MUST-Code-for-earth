# MUST — environment template.
# Copy to .env.local (gitignored) and fill in real values.
# Only NEXT_PUBLIC_* are read by the app; they are exposed to the browser bundle,
# so never put secrets here.

# ── Data API (FastAPI app.py, proxied via Next.js rewrites) ───────────────────
# Local dev: http://localhost:8000 (the app.py exceedance backend).
# Production: the Cloud Run URL of the deployed API (identity-token auth is added
# automatically by app/lib/api-fetch.ts when this is a non-localhost URL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── LIVE-TILE BACKEND (the one-line mock→real swap) ───────────────────────────
# Empty  → placeholder mode: <LiveMap> reads the single pre-rendered tile under
#          /public/mock-tiles (currently 2026-03-04) until the cloud data lands.
# Set    → live mode: <LiveMap> reads raster tiles from TiTiler and vector
#          features from TiPg — the GRIB2-derived exceedance products from the
#          icpac-igad/code-for-earth pipeline. See docs/SWAP-TO-REAL-BACKEND.md.
# The two are independent; bring one online before the other.
NEXT_PUBLIC_TITILER_URL=
NEXT_PUBLIC_TIPG_URL=

# ── Site ──────────────────────────────────────────────────────────────────────
# Absolute base URL for OpenGraph / metadata. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

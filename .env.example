# MUST stack environment. Copy to .env for docker compose.
# Only NEXT_PUBLIC_* reach the browser bundle, so keep secrets out of them.

# Frontend
# Browser-facing tiler URL; set the public URL behind a reverse proxy.
NEXT_PUBLIC_TILER_XR_BASE=http://localhost:8090
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FRONTEND_HOST_PORT=3000

# Backend
XR_HOST_PORT=8090
# Store path inside the container. Empty streams the published store from
# source.coop (works on a fresh clone); set to /store once you have materialized
# one into backend/store-local.
XR_LOCAL_STORE_PATH=
# Return-period thresholds file; empty disables the exceedance layer.
CMORPH_THRESHOLDS_URL=/data/cmorph_ea_return_periods.nc
# GPM IMERG daily rainfall file; empty disables the observation layer.
IMERG_DAILY_URL=/data/gpm_imerg_ea_daily.nc

# Local Dask tuning (see backend/app/config.py).
XR_DASK_THREADS=12
XR_DASK_MEM_FRACTION=0.5
XR_DASK_SCHEDULER=distributed
XR_CACHE_DATES=4
TITILER_XR_MEM_LIMIT=1500m

# Host directories bind-mounted into the backend.
XR_DATA_HOST_DIR=./backend/data
XR_CACHE_HOST_DIR=./backend/cache
XR_LOCAL_STORE_HOST_DIR=./backend/store-local

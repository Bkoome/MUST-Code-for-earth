# Local datasets: large or licensed, kept on disk and out of git.
# See the "Local dataset" section of the README for how to obtain each one.

# materialized EA tp Icechunk store (~1.2 GB)
backend/store-local/
# derived-field cache + calendar summaries, rebuilt at runtime
backend/cache/
# CMORPH thresholds (~330 MB) and GPM IMERG daily (~10 MB)
backend/data/*.nc
# raw EM-DAT export (redistribution restricted; the parsed subset is committed)
backend/tools/emdat/*.xlsx
# host bind-mount for the containerized backend (/data); large + licensed
Data/
# raw DesInventar country exports (national copyright, citation required to
# reproduce; the parsed subset is committed as data/catalogue.sqlite)
backend/tools/catalogue/sources/

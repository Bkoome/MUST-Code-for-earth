# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.vscode/*
!.vscode/settings.json.sample

# local agent / tooling settings
.claude/

# docs kept local, not published
docs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real secrets; commit *.example / *-sample instead)
.env
.env.local
.env*.local

# deploy secrets
_build_fe.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]

# generated content (rebuilt via scripts/generate_*.py)
/app/content/events/

# generated mock data (rebuilt via backend/generate_exceedance_mock.py)
/backend/data/*.parquet
